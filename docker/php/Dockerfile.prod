FROM php:8.4-fpm-alpine AS php_base
RUN apk add --no-cache postgresql-dev icu-dev libzip-dev linux-headers $PHPIZE_DEPS && docker-php-ext-install pdo_pgsql intl opcache && apk del $PHPIZE_DEPS
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
WORKDIR /var/www/html
COPY composer.json composer.lock symfony.lock ./
RUN composer install --no-dev --no-interaction --no-progress --prefer-dist --no-scripts --classmap-authoritative
COPY . .
RUN composer dump-autoload --no-dev --classmap-authoritative --no-interaction && mkdir -p var/cache var/log && chown -R www-data:www-data var
COPY docker/php/entrypoint.prod.sh /usr/local/bin/compendium-prod-entrypoint
RUN chmod +x /usr/local/bin/compendium-prod-entrypoint
USER www-data
ENTRYPOINT ["compendium-prod-entrypoint"]
CMD ["php-fpm"]
