{% extends 'base.html.twig' %}{% block title %}Compendium — Bibliothèque de projets{% endblock %}{% block body %}
<section class="home-hero"><div><span class="kicker">BIBLIOTHÈQUE PERSONNELLE PUBLIQUE</span><h1>Des travaux,<br>des idées,<br><em>une mémoire.</em></h1><p>Compendium rassemble des notes, des articles et des documents conçus pour être lus, retrouvés et transmis.</p></div><form id="recherche" class="search" method="get"><label for="q">Chercher dans la bibliothèque</label><div><input id="q" name="q" value="{{ query }}" placeholder="Un titre, un thème, une idée…"><button>RECHERCHER <span>→</span></button></div></form></section>
{% if search_fallback %}<div class="notice">La recherche utilise temporairement le catalogue PostgreSQL.</div>{% endif %}
{% if featured and query == '' %}<section id="a-la-une" class="editorial-section"><header class="section-title"><span>01</span><h2>À la une</h2></header><div class="featured-layout">{% for item in featured %}{% if item.publication and item.publication.statut.value == 'publie' %}<article class="editorial-card {{ loop.first ? 'lead' : 'secondary' }}"><span class="border-label">{{ item.publication.type.value }}</span><div><small>{{ item.publication.theme.nom }} · {{ item.publication.langue|upper }}</small><h3><a href="{{ path('app_publication_show',{id:item.publication.id}) }}">{{ item.publication.titre }}</a></h3><p>{{ item.publication.contenu|striptags|slice(0,loop.first ? 320 : 150) }}{% if item.publication.contenu|length > 150 %}…{% endif %}</p></div><a class="read-link" href="{{ path('app_publication_show',{id:item.publication.id}) }}">Lire <span>↗</span></a></article>{% endif %}{% endfor %}</div></section>{% endif %}
<section id="recentes" class="editorial-section"><header class="section-title"><span>02</span><h2>{{ query ? 'Résultats pour “'~query~'”' : 'Publications récentes' }}</h2></header><div class="publication-list">{% for publication in publications %}<article><div class="publication-index">{{ '%02d'|format(loop.index) }}</div><div><small>{{ publication.type.value }} · {{ publication.langue|upper }} · {{ publication.theme.nom }}</small><h3><a href="{{ path('app_publication_show',{id:publication.id}) }}">{{ publication.titre }}</a></h3><p>{{ publication.contenu|striptags|slice(0,210) }}…</p></div><time>{{ publication.createdAt|date('d.m.Y') }}</time></article>{% else %}<p>Aucune publication trouvée.</p>{% endfor %}</div></section>
<section class="editorial-section themes-section"><header class="section-title"><span>03</span><h2>Explorer les thèmes</h2></header><div class="theme-links">{% for theme in themes %}<a href="{{ path('app_theme_show',{slug:theme.slug}) }}"><i class="{{ theme.iconeFontawesome }}"></i><span>{{ theme.nom }}</span><b>→</b></a>{% endfor %}</div></section>
<section id="apropos" class="about"><span>À PROPOS</span><p>Un espace éditorial indépendant pour publier des recherches, des créations et des documents longs sans les réduire au rythme d’un fil d’actualité.</p></section>{% endblock %}
