{% extends 'base.html.twig' %}{% block title %}Publications — Admin{% endblock %}{% block body %}{% include 'admin/_nav.html.twig' %}<div class="section-head"><h1>Publications</h1><a class="button" href="{{ path('app_admin_publication_new') }}">Nouvelle publication</a></div><div class="table-wrap"><table><thead><tr><th>Titre</th><th>Type</th><th>Thème</th><th>Statut</th><th>Source</th><th>MAJ</th><th></th></tr></thead><tbody>{% for p in publications %}<tr><td><strong>{{ p.titre }}</strong></td><td>{{ p.type.value }}</td><td>{{ p.theme.nom }}</td><td><span class="status {{ p.statut.value }}">{{ p.statut.value }}</span></td><td>{{ p.source.value }}</td><td>{{ p.updatedAt|date('d/m/Y H:i') }}</td><td class="row-actions"><a class="small-button" href="{{ path('app_admin_publication_edit',{id:p.id}) }}">Modifier</a><a class="small-button secondary" href="{{ path('app_publication_show',{id:p.id}) }}">Voir</a><form method="post" action="{{ path('app_admin_publication_delete',{id:p.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('publication_delete_'~p.id) }}"><button class="danger small">Supprimer</button></form></td></tr>{% endfor %}</tbody></table></div>{% endblock %}
