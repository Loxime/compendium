{% extends 'base.html.twig' %}{% block title %}À la une — Admin{% endblock %}{% block body %}{% include 'admin/_nav.html.twig' %}<div class="admin-grid"><section><h1>À la une</h1><div class="featured-list">{% for item in featured %}<div class="featured-row"><strong>#{{ item.position }}</strong><span>{{ item.publication.titre }}</span><form method="post" action="{{ path('app_admin_featured_delete',{id:item.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('featured_delete_'~item.id) }}"><button class="danger small">Retirer</button></form></div>{% else %}<p>Aucune mise en avant.</p>{% endfor %}</div></section><aside class="panel"><h2>Ajouter/remplacer</h2><form method="post" class="stack"><input type="hidden" name="_token" value="{{ csrf_token('featured_save') }}"><label>Position<input type="number" min="1" max="10" name="position" value="1"></label><label>Publication<select name="publication_id">{% for p in publications %}<option value="{{ p.id }}">{{ p.titre }}</option>{% endfor %}</select></label><button>Mettre à la une</button></form></aside></div>{% endblock %}
