{% extends 'base.html.twig' %}{% block body %}{% include 'admin/_nav.html.twig' %}<section class="auth-card"><h1>Modifier {{ theme.nom }}</h1><form method="post" class="stack"><input type="hidden" name="_token" value="{{ csrf_token('theme_edit_'~theme.id) }}"><label>Nom<input name="nom" value="{{ theme.nom }}" required></label><label>Slug<input name="slug" value="{{ theme.slug }}" required></label><label>Classe FontAwesome<input name="icone" value="{{ theme.iconeFontawesome }}"></label><label>Ordre<input type="number" name="ordre" value="{{ theme.ordre }}"></label><button>Enregistrer</button></form></section>{% endblock %}
