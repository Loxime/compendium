{% extends 'base.html.twig' %}{% block title %}Drive — Admin{% endblock %}{% block body %}{% include 'admin/_nav.html.twig' %}<section class="hero compact"><div><span class="eyebrow">GOOGLE DRIVE</span><h1>Synchronisation</h1><p>Le mode réel reste désactivé tant que des credentials locaux ne sont pas fournis.</p></div></section><div class="notice">État réel : <strong>{{ drive_enabled ? 'activé' : 'désactivé' }}</strong>. {% if missing %}Configuration manquante : {{ missing|join(', ') }}.{% endif %}</div><section class="panel wide"><h2>Simuler un ajout / une modification Drive</h2><p>Réutiliser le même <code>drive_file_id</code> simule une modification : la publication repasse automatiquement en <strong>brouillon</strong>.</p><form method="post" class="stack"><input type="hidden" name="_token" value="{{ csrf_token('drive_demo') }}"><div class="two"><label>Drive file ID<input name="drive_file_id" value="demo-google-doc-1"></label><label>Thème<select name="theme_id">{% for theme in themes %}<option value="{{ theme.id }}">{{ theme.nom }}</option>{% endfor %}</select></label></div><div class="two"><label>Titre<input name="titre" value="[FR] Document Drive de démonstration"></label><label>Langue<input name="langue" value="fr"></label></div><label>Contenu HTML<textarea name="contenu" class="editor-area">&lt;h2&gt;Document importé&lt;/h2&gt;&lt;p&gt;Cette simulation reproduit le cycle brouillon → validation admin.&lt;/p&gt;</textarea></label><button>Simuler l’import</button></form></section>{% endblock %}
