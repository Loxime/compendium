{% extends 'base.html.twig' %}{% block title %}{{ title }} — Admin{% endblock %}{% block body %}{% include 'admin/_nav.html.twig' %}<section class="editor"><div class="section-head"><h1>{{ title }}</h1><a href="{{ path('app_admin_publications') }}">Retour</a></div><form method="post" class="stack"><input type="hidden" name="_token" value="{{ csrf_token(csrf_id) }}"><label>Titre<input name="titre" required value="{{ publication.titre }}"></label><div class="three"><label>Type<select name="type">{% for v in ['note','idee','doc'] %}<option value="{{ v }}" {% if publication.type.value == v %}selected{% endif %}>{{ v }}</option>{% endfor %}</select></label><label>Thème<select name="theme_id">{% for theme in themes %}<option value="{{ theme.id }}" {% if publication.theme and publication.theme.id == theme.id %}selected{% endif %}>{{ theme.nom }}</option>{% endfor %}</select></label><label>Langue<input name="langue" value="{{ publication.langue ?: 'fr' }}" maxlength="10"></label></div><div class="two"><label>Format<select name="contenu_format">{% for v in ['texte_brut','html_drive','editorjs_json'] %}<option value="{{ v }}" {% if publication.contenuFormat.value == v %}selected{% endif %}>{{ v }}</option>{% endfor %}</select></label><label>Statut<select name="statut">{% for v in ['brouillon','publie','archive'] %}<option value="{{ v }}" {% if publication.statut.value == v %}selected{% endif %}>{{ v }}</option>{% endfor %}</select></label></div><label>Contenu<textarea name="contenu" class="editor-area" required>{{ publication.contenu }}</textarea></label><button>Enregistrer</button></form></section>{% endblock %}
