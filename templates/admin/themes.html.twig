{% extends 'base.html.twig' %}{% block title %}Thèmes — Admin{% endblock %}{% block body %}{% include 'admin/_nav.html.twig' %}<div class="admin-grid"><section><h1>Thèmes</h1><table><thead><tr><th>Ordre</th><th>Nom</th><th>Slug</th><th></th></tr></thead><tbody>{% for theme in themes %}<tr><td>{{ theme.ordre }}</td><td>{{ theme.nom }}</td><td><code>{{ theme.slug }}</code></td><td class="row-actions"><a class="small-button" href="{{ path('app_admin_theme_edit',{id:theme.id}) }}">Modifier</a><form method="post" action="{{ path('app_admin_theme_delete',{id:theme.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('theme_delete_'~theme.id) }}"><button class="danger small">Supprimer</button></form></td></tr>{% endfor %}</tbody></table></section><aside class="panel"><h2>Nouveau thème</h2><form method="post" class="stack"><input type="hidden" name="_token" value="{{ csrf_token('theme_new') }}"><label>Nom<input name="nom" required></label><label>Slug<input name="slug" placeholder="auto si vide"></label><label>Classe FontAwesome<input name="icone" value="fa-solid fa-book"></label><label>Ordre<input type="number" name="ordre" value="0"></label><button>Créer</button></form></aside></div>{% endblock %}
