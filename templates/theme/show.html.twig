{% extends 'base.html.twig' %}{% block title %}{{ theme.nom }} — Compendium{% endblock %}{% block body %}<section class="theme-hero"><i class="{{ theme.iconeFontawesome }}"></i><div><span class="kicker">THÈME</span><h1>{{ theme.nom }}</h1><p>{{ publications|length }} publication{{ publications|length > 1 ? 's' : '' }}</p></div></section><div class="publication-list theme-publications">{% for publication in publications %}<article><div class="publication-index">{{ '%02d'|format(loop.index) }}</div><div><small>{{ publication.type.value }} · {{ publication.langue|upper }}</small><h3><a href="{{ path('app_publication_show',{id:publication.id}) }}">{{ publication.titre }}</a></h3><p>{{ publication.contenu|striptags|slice(0,240) }}…</p></div><time>{{ publication.createdAt|date('d.m.Y') }}</time></article>{% else %}<p>Aucune publication publiée dans ce thème.</p>{% endfor %}</div>{% endblock %}
