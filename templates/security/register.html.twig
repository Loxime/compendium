{% extends 'base.html.twig' %}{% block title %}Créer un compte — Compendium{% endblock %}{% block body %}<section class="auth-page"><div><span class="kicker">NOUVEAU LECTEUR</span><h1>Créer un compte</h1><p>Aucun mot de passe à mémoriser.</p></div><form id="passkey-register" class="auth-form"><div class="two"><label>Prénom<input name="prenom" required autocomplete="given-name"></label><label>Nom<input name="nom" required autocomplete="family-name"></label></div><label>Adresse e-mail<input name="email" type="email" required autocomplete="email username"></label><label>Code postal <span>(facultatif)</span><input name="code_postal" autocomplete="postal-code"></label><button type="submit">CRÉER MON COMPTE ET MA PASSKEY <span>→</span></button><a href="{{ path('app_login') }}">J’ai déjà un compte</a><p class="form-error" data-passkey-error hidden></p></form></section>{% endblock %}{% block scripts %}<script src="/scripts/passkeys.js"></script><script>CompendiumPasskeys.register(document.querySelector('#passkey-register'),'{{ path('webauthn.controller.creation.request.new_user') }}','{{ path('webauthn.controller.creation.response.new_user') }}','{{ path('app_login') }}');</script>{% endblock %}
