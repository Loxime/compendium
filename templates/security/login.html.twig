{% extends 'base.html.twig' %}{% block title %}Connexion — Compendium{% endblock %}{% block body %}
<section class="auth-card"><span class="eyebrow">PASSWORDLESS</span><h1>Connexion par lien magique</h1><p>Si l’adresse n’existe pas encore, un compte minimal sera créé.</p><form method="post" class="stack"><input type="hidden" name="_token" value="{{ csrf_token('login_request') }}"><label>Email<input type="email" name="email" required placeholder="vous@example.com"></label><div class="two"><label>Prénom<input name="prenom" placeholder="Requis à la création"></label><label>Nom<input name="nom" placeholder="Requis à la création"></label></div><label>Code postal <span>(optionnel)</span><input name="code_postal"></label><button>Recevoir mon lien</button></form><p class="hint">Test local admin : utilisez <code>admin@compendium.local</code>, puis ouvrez Mailpit.</p></section>
{% endblock %}
