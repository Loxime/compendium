{% extends 'base.html.twig' %}{% block title %}Connexion — Compendium{% endblock %}{% block body %}<section class="auth-page"><div><span class="kicker">ACCÈS</span><h1>Se connecter</h1><p>Aucun mot de passe à mémoriser.</p></div><form id="passkey-login" method="post" class="auth-form"><label>Adresse e-mail <span>(facultatif)</span><input name="_username" type="email" value="{{ last_username }}" autocomplete="username webauthn" placeholder="vous@exemple.fr"></label><input type="hidden" name="_assertion">{% if error %}<p class="form-error">{{ error.messageKey }}</p>{% endif %}<button type="submit">SE CONNECTER AVEC UNE PASSKEY <span>→</span></button><a href="{{ path('app_register') }}">Créer un compte</a><p class="form-error" data-passkey-error hidden></p></form></section>{% endblock %}{% block scripts %}<script src="/scripts/passkeys.js"></script><script>CompendiumPasskeys.login(document.querySelector('#passkey-login'),'{{ path('webauthn.controller.request.request.login') }}');</script>{% endblock %}
