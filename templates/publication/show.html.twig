{% extends 'base.html.twig' %}{% block title %}{{ publication.titre }} — Compendium{% endblock %}{% block body %}<article class="document"><header class="document-header"><nav class="breadcrumbs"><a href="{{ path('app_home') }}">Compendium</a><span>→</span><a href="{{ path('app_theme_show',{slug:publication.theme.slug}) }}">{{ publication.theme.nom }}</a></nav><div class="document-labels"><span>{{ publication.type.value }}</span><span>{{ publication.langue|upper }}</span><span>{{ publication.theme.nom }}</span></div><h1>{{ publication.titre }}</h1><div class="document-meta"><span>Publié le {{ publication.createdAt|date('d.m.Y') }}</span><span>Mis à jour le {{ publication.updatedAt|date('d.m.Y') }}</span></div>{% if translations|default([]) %}<nav class="translations" aria-label="Traductions"><b>Langues disponibles</b>{% for translation in translations %}<a href="{{ path('app_publication_show',{id:translation.id}) }}" hreflang="{{ translation.langue }}" class="{{ translation.id == publication.id ? 'current' : '' }}">{{ translation.langue|upper }}</a>{% endfor %}</nav>{% endif %}</header><div class="reading-column"><div class="prose">{{ publication.contenu|nl2br }}</div></div></article>
<section class="engagement"><div><b>{{ publication.nbLikes }}</b> likes <b>{{ publication.nbDislikes }}</b> dislikes</div>{% if app.user %}<div class="actions"><form method="post" action="{{ path('app_publication_react',{id:publication.id,type:'like'}) }}"><input type="hidden" name="_token" value="{{ csrf_token('react_'~publication.id) }}"><button>J’AIME</button></form><form method="post" action="{{ path('app_publication_react',{id:publication.id,type:'dislike'}) }}"><input type="hidden" name="_token" value="{{ csrf_token('react_'~publication.id) }}"><button class="secondary">JE N’AIME PAS</button></form></div>{% else %}<a class="button" href="{{ path('app_login') }}">SE CONNECTER POUR RÉAGIR</a>{% endif %}</section><section class="comments"><span class="border-label">Avis</span>{% if app.user %}<form method="post" action="{{ path('app_publication_comment',{id:publication.id}) }}" class="stack"><input type="hidden" name="_token" value="{{ csrf_token('comment_'~publication.id) }}"><textarea name="contenu" maxlength="4000" required placeholder="Écrire un avis…"></textarea><button>PUBLIER L’AVIS</button></form>{% endif %}{% for avis in publication.avis %}<article class="comment"><header><strong>{{ avis.user ? avis.user.prenom~' '~avis.user.nom : '[user_deleted]' }}</strong><time>{{ avis.createdAt|date('d.m.Y') }}</time></header><p>{{ avis.contenu }}</p></article>{% else %}<p>Aucun avis pour le moment.</p>{% endfor %}</section>{% endblock %}
