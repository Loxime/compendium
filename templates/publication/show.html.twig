{% extends 'base.html.twig' %}{% block title %}{{ publication.titre }} — Compendium{% endblock %}{% block body %}
<section class="article-hero"><div class="breadcrumbs"><a href="{{ path('app_home') }}">Accueil</a> / <a href="{{ path('app_theme_show',{slug:publication.theme.slug}) }}">{{ publication.theme.nom }}</a></div><span class="tag">{{ publication.type.value }} · {{ publication.langue|upper }}</span><h1>{{ publication.titre }}</h1><div class="meta">Mis à jour le {{ publication.updatedAt|date('d/m/Y à H:i') }} · source {{ publication.source.value }}</div></section>
<article class="article-body">{% if publication.contenuFormat.value == 'html_drive' %}<div class="drive-note">Contenu importé depuis Drive — rendu échappé dans ce MVP pour éviter l’injection HTML.</div>{% endif %}<div class="prose">{{ publication.contenu|nl2br }}</div></article>
<section class="engagement"><div><strong>{{ publication.nbLikes }}</strong> likes · <strong>{{ publication.nbDislikes }}</strong> dislikes</div>{% if app.user %}<div class="actions"><form method="post" action="{{ path('app_publication_react',{id:publication.id,type:'like'}) }}"><input type="hidden" name="_token" value="{{ csrf_token('react_'~publication.id) }}"><button>👍 Like</button></form><form method="post" action="{{ path('app_publication_react',{id:publication.id,type:'dislike'}) }}"><input type="hidden" name="_token" value="{{ csrf_token('react_'~publication.id) }}"><button class="secondary">👎 Dislike</button></form></div>{% else %}<a class="button" href="{{ path('app_login') }}">Se connecter pour réagir</a>{% endif %}</section>
<section class="comments"><h2>Avis</h2>{% if app.user %}<form method="post" action="{{ path('app_publication_comment',{id:publication.id}) }}" class="stack"><input type="hidden" name="_token" value="{{ csrf_token('comment_'~publication.id) }}"><textarea name="contenu" maxlength="4000" required placeholder="Ajouter un avis…"></textarea><button>Publier l’avis</button></form>{% endif %}<div class="comment-list">{% for avis in publication.avis %}<article class="comment"><strong>{% if avis.user %}{{ avis.user.prenom }} {{ avis.user.nom }}{% else %}[user_deleted]{% endif %}</strong><small>{{ avis.createdAt|date('d/m/Y H:i') }}</small><p>{{ avis.contenu }}</p></article>{% else %}<p>Aucun avis pour le moment.</p>{% endfor %}</div></section>
{% endblock %}
