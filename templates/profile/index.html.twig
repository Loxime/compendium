{% extends 'base.html.twig' %}{% block title %}Profil — Compendium{% endblock %}{% block body %}<section class="profile-header"><span class="kicker">PROFIL</span><h1>{{ app.user.prenom }}<br>{{ app.user.nom }}</h1></section><div class="profile-grid"><section class="lined-panel"><span class="border-label">Identité</span><dl><dt>Adresse e-mail</dt><dd>{{ app.user.email }}</dd><dt>Code postal</dt><dd>{{ app.user.codePostal ?: 'Non renseigné' }}</dd><dt>Membre depuis</dt><dd>{{ app.user.createdAt|date('d.m.Y') }}</dd></dl></section><section class="lined-panel"><span class="border-label">Passkeys</span>{% for passkey in app.user.passkeys %}<div class="passkey-row"><i class="fa-solid fa-key"></i><div><strong>{{ passkey.name }}</strong><small>Ajoutée le {{ passkey.createdAt|date('d.m.Y') }}</small></div></div>{% else %}<p>Aucune passkey enregistrée.</p>{% endfor %}</section></div><section class="danger-zone"><h2>Supprimer définitivement le compte</h2><p>Les passkeys et réactions seront supprimées. Les avis resteront publiés sous <code>[user_deleted]</code>.</p><form method="post" action="{{ path('app_profile_delete') }}" onsubmit="return confirm('Confirmez-vous la suppression définitive de votre compte ? Cette action est irréversible.')"><input type="hidden" name="_token" value="{{ csrf_token('delete_account') }}"><label class="confirm"><input type="checkbox" required> Je comprends que cette action est irréversible.</label><button class="danger">SUPPRIMER MON COMPTE</button></form></section>{% endblock %}
