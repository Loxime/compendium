{% extends 'base.html.twig' %}{% block title %}Profil — Compendium{% endblock %}{% block body %}<section class="auth-card"><span class="eyebrow">PROFIL</span><h1>{{ app.user.prenom }} {{ app.user.nom }}</h1><p>{{ app.user.email }}</p>{% if app.user.codePostal %}<p>Code postal : {{ app.user.codePostal }}</p>{% endif %}<hr><h2>Supprimer mon compte</h2><p>La suppression est définitive. Les avis restent sous <code>[user_deleted]</code> et les réactions individuelles sont supprimées.</p><form method="post" action="{{ path('app_profile_delete') }}" onsubmit="return confirm('Supprimer définitivement le compte ?')"><input type="hidden" name="_token" value="{{ csrf_token('delete_account') }}"><button class="danger">Supprimer mon compte</button></form></section>{% endblock %}
